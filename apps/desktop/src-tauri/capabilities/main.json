{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-workspace",
  "description": "Local main window database operations only; no shell, filesystem or remote capabilities.",
  "windows": ["main"],
  "permissions": [
    "allow-desktop-request",
    "allow-watch-execution",
    "core:window:allow-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
