{
  "name": "database-studio",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @database-studio/desktop dev",
    "desktop": "pnpm --filter @database-studio/desktop tauri dev",
    "build": "pnpm --filter @database-studio/desktop build",
    "typecheck": "pnpm --filter @database-studio/desktop typecheck",
    "test": "vitest run",
    "format": "prettier --write 'apps/{desktop,web}/src/**/*.{ts,tsx}' 'apps/desktop/src-tauri/{tauri*.json,capabilities/*.json}' 'packages/**/*.{ts,tsx,css,json}' 'package.json' '.prettierrc.json' 'apps/web/vite.config.ts' '*.mjs' 'pnpm-workspace.yaml' 'scripts/*.mjs' 'tests/**/*.{ts,mjs}' '.github/workflows/*.yml'",
    "format:check": "prettier --check 'apps/{desktop,web}/src/**/*.{ts,tsx}' 'apps/desktop/src-tauri/{tauri*.json,capabilities/*.json}' 'packages/**/*.{ts,tsx,css,json}' 'package.json' '.prettierrc.json' 'apps/web/vite.config.ts' '*.mjs' 'pnpm-workspace.yaml' 'scripts/*.mjs' 'tests/**/*.{ts,mjs}' '.github/workflows/*.yml'",
    "test:native": "node scripts/desktop-e2e.mjs",
    "web": "pnpm --filter @database-studio/web dev",
    "build:web": "pnpm --filter @database-studio/web build",
    "typecheck:web": "pnpm --filter @database-studio/web typecheck",
    "test:web-browser": "node scripts/web-browser.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@wdio/cli": "9.31.3",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.3",
    "@wdio/mocha-framework": "9.31.2",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.5.0",
    "jsdom": "30.1.2",
    "prettier": "3.8.1",
    "vitest": "5.0.3",
    "webdriverio": "9.31.9"
  }
}
